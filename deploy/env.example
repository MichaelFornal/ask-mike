# /etc/ask/env on the box (owner root:root, mode 600; push.sh refuses otherwise). Mike writes it on the box; no value
# is ever in the repo. ANTHROPIC_API_KEY is Ask Mike's own key, never Deal Terms Desk's. ASK_MONTH_CAP_USD and
# ASK_DAY_CAP_USD are facts.json m3_model_cap_usd and m3_day_cap_usd: push.sh refuses any other value.
ANTHROPIC_API_KEY=
ASK_MONTH_CAP_USD=
ASK_DAY_CAP_USD=
ASK_STATE=/var/lib/ask
ASK_INDEX=/srv/ask/current/index.db
ASK_GATE_CONFIG=/etc/ask/gate_config.json
FASTEMBED_CACHE_PATH=/var/lib/ask/fastembed
HF_HOME=/var/lib/ask/huggingface
